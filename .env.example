# Copy to .env and fill in. Every value has a sensible default.

# --- LLM ---------------------------------------------------------------
# "anthropic" calls the Claude API; "fake" is a deterministic offline stub (free, used in tests).
CLEARANCE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Router sends easy questions to the small model and hard ones to the large one.
CLEARANCE_SMALL_MODEL=claude-haiku-4-5
CLEARANCE_LARGE_MODEL=claude-opus-5
CLEARANCE_JUDGE_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max  (large model only)
CLEARANCE_LARGE_EFFORT=medium
# Router threshold in [0,1]: difficulty scores above it go to the large model.
CLEARANCE_ROUTER_THRESHOLD=0.5

# --- Embeddings --------------------------------------------------------
# "local" = Hugging Face model via torch/transformers (pip install -e .[ml]); "hash" = dependency-free lexical hashing.
CLEARANCE_EMBEDDER=local
CLEARANCE_EMBED_MODEL=BAAI/bge-small-en-v1.5
CLEARANCE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval ---------------------------------------------------------
# bm25 | vector | hybrid
CLEARANCE_RETRIEVAL_MODE=hybrid
CLEARANCE_USE_RERANKER=false
CLEARANCE_USE_GRAPH=true
CLEARANCE_TOP_K=8

# --- Semantic cache ----------------------------------------------------
# off | global (INSECURE, for the red-team demo) | per_user | acl_aware
CLEARANCE_CACHE_MODE=acl_aware
CLEARANCE_CACHE_THRESHOLD=0.92
CLEARANCE_CACHE_TTL_SECONDS=86400

# --- Paths -------------------------------------------------------------
CLEARANCE_DATA_DIR=data
